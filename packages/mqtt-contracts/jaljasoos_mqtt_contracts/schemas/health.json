{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ESP32 Node Health Report",
  "type": "object",
  "required": ["node_id", "timestamp", "status"],
  "properties": {
    "node_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["ONLINE", "DEGRADED", "OFFLINE"] },
    "uptime_seconds": { "type": "integer", "minimum": 0 },
    "free_heap_bytes": { "type": "integer", "minimum": 0 },
    "wifi_rssi": { "type": "integer" },
    "mqtt_reconnects": { "type": "integer", "minimum": 0 },
    "battery_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "cpu_temp_c": { "type": "number" },
    "firmware_version": { "type": "string" }
  },
  "additionalProperties": false
}
