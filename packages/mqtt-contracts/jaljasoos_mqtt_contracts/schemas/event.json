{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ESP32 / Gateway Event",
  "type": "object",
  "required": ["event_id", "node_id", "event_type", "timestamp"],
  "properties": {
    "event_id": { "type": "string" },
    "node_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "NODE_BOOT", "NODE_SHUTDOWN", "SENSOR_ERROR", "VALVE_FAULT",
        "MQTT_RECONNECT", "LOW_BATTERY", "PRESSURE_SPIKE", "FLOW_ANOMALY",
        "ACOUSTIC_ANOMALY", "PUMP_FAULT", "TANK_OVERFLOW", "TANK_EMPTY"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
    "message": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
